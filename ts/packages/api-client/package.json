{
  "name": "@earthed/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript client for the Earthed API, generated from the OpenAPI spec using @hey-api/openapi-ts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "gen": "openapi-ts && node scripts/strip-import-extensions.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5"
  }
}
