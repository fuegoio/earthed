# Earthed API configuration
# Copy to .env and adjust values.

# HTTP
EARTHED_HTTP_ADDR=:8080
EARTHED_BASE_URL=http://localhost:8080
EARTHED_WEB_URL=http://localhost:3000

# Database
EARTHED_DATABASE_URL=postgres://earthed:earthed@localhost:5432/earthed?sslmode=disable

# Logging: pretty or json
EARTHED_LOG_FORMAT=pretty

# Scheduler
EARTHED_POLLING_FREQUENCY=60s
EARTHED_BATCH_SIZE=100
EARTHED_WORKER_POOL_SIZE=5
EARTHED_DISABLE_SCHEDULER=

# Feed fetching
EARTHED_HTTP_CLIENT_TIMEOUT=20s
EARTHED_HTTP_CLIENT_MAX_BODY=15728640

# Cleanup
EARTHED_CLEANUP_FREQUENCY=24h
EARTHED_ENTRY_MAX_AGE_DAYS=60

# AT Proto OAuth
# The client_id and callback URL default from EARTHED_BASE_URL:
#   http://localhost:8080/client-metadata.json
#   http://localhost:8080/auth/oauth/callback
# For loopback dev, the localhost OAuth client config is used automatically
# (no metadata document fetch needed). Override either with these env vars:
# EARTHED_OAUTH_CLIENT_ID=
# EARTHED_OAUTH_REDIRECT_URL=

# Default PDS for signup. When set, the login page shows a "Create an account"
# link that starts the OAuth flow against this PDS. Leave unset to offer
# existing-handle login only.
EARTHED_DEFAULT_PDS=https://earthed.app

# Relay. When set, the API announces users to the relay and queries it for
# global counts. Leave empty to disable relay integration.
EARTHED_RELAY_URL=http://localhost:9090

# Session cookies
# Secure: mark cookies as Secure (required for cookies over HTTPS)
EARTHED_COOKIE_SECURE=false
# SameSite mode: lax, none, or strict. none requires EARTHED_COOKIE_SECURE=true
EARTHED_COOKIE_SAMESITE=lax
# Bare host to set as the cookie Domain (e.g. earthed.app) so the session is
# shared across subdomains (API and web app on different subdomains).
# Set to the registrable domain shared by both; leave unset for same-origin.
EARTHED_COOKIE_DOMAIN=
# Comma-separated list of allowed browser origins (e.g. https://app.earthed.app).
# Unset = any origin allowed (local development only).
# When set, EARTHED_WEB_URL is included automatically.
EARTHED_TRUSTED_ORIGINS=
