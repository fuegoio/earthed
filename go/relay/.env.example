# Earthed relay configuration
# Copy to .env and adjust values.

# HTTP
RELAY_HTTP_ADDR=:9090

# Database (shares the earthed-postgres container with the API)
RELAY_DATABASE_URL=postgres://earthed:earthed@localhost:5432/earthed_relay?sslmode=disable

# Logging: pretty or json
RELAY_LOG_FORMAT=pretty

# Fanout
RELAY_FANOUT_WORKERS=50
RELAY_RECONNECT_DELAY=5s

# Event retention (how long to keep relay_events rows for cursor replay)
RELAY_EVENT_RETENTION=168h
