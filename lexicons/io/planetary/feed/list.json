{
  "lexicon": 1,
  "id": "io.planetary.feed.list",
  "defs": {
    "main": {
      "type": "record",
      "description": "A curated, shareable feed list. The repo owner publishes a named collection of feed URLs.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "Feed list title."
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "description": "Optional description of the list's purpose or theme."
          },
          "isPublic": {
            "type": "boolean",
            "description": "Whether the list is publicly discoverable.",
            "default": true
          },
          "feeds": {
            "type": "array",
            "description": "Ordered array of feed entries in this list.",
            "items": {
              "type": "ref",
              "ref": "#feedEntry"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "feedEntry": {
      "type": "object",
      "description": "A single feed reference within a feed list.",
      "required": ["feedUrl"],
      "properties": {
        "feedUrl": {
          "type": "string",
          "format": "uri"
        },
        "siteUrl": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
