{
  "lexicon": 1,
  "id": "io.earthed.actor.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "A Earthed user profile. Stored in the user's PDS repo under io.earthed.actor.profile/self.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["handle", "createdAt"],
        "properties": {
          "handle": {
            "type": "string",
            "maxLength": 64,
            "description": "The user's Earthed handle (e.g. 'fuego'). Unique within the instance."
          },
          "bio": {
            "type": "string",
            "maxLength": 500,
            "description": "Short biography."
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "Human-readable display name."
          },
          "instanceUrl": {
            "type": "string",
            "format": "uri",
            "description": "Base URL of the Earthed instance this user belongs to."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "ISO 8601 timestamp when the profile was first created."
          }
        }
      }
    }
  }
}
